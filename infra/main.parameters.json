{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "principalId": {
        "value": "${AZURE_PRINCIPAL_ID}"
      },
      "alertEmail": {
        "value": "${AZURE_ALERT_EMAIL}"
      },
      "entraMerchantUserObjectId": {
        "value": "${AZURE_ENTRA_MERCHANT_USER_OBJECT_ID}"
      },
      "entraPublicApiClientId": {
        "value": "${AZURE_ENTRA_PUBLIC_API_CLIENT_ID}"
      },
      "entraTenantId": {
        "value": "${AZURE_ENTRA_TENANT_ID}"
      },
      "parcelgo_webhook_secret": {
        "value": "${AZURE_PARCELGO_WEBHOOK_SECRET}"
      },
      "redis_password": {
        "value": "${AZURE_REDIS_PASSWORD}"
      },
      "environmentName": {
        "value": "${AZURE_ENV_NAME}"
      },
      "location": {
        "value": "${AZURE_LOCATION}"
      }
    }
  }
  