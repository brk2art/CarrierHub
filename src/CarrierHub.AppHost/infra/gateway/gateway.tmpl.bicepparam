using './gateway-containerapp.module.bicep'

param env_outputs_azure_container_apps_environment_default_domain = '{{ .Env.ENV_AZURE_CONTAINER_APPS_ENVIRONMENT_DEFAULT_DOMAIN }}'
param env_outputs_azure_container_apps_environment_id = '{{ .Env.ENV_AZURE_CONTAINER_APPS_ENVIRONMENT_ID }}'
param env_outputs_azure_container_registry_endpoint = '{{ .Env.ENV_AZURE_CONTAINER_REGISTRY_ENDPOINT }}'
param env_outputs_azure_container_registry_managed_identity_id = '{{ .Env.ENV_AZURE_CONTAINER_REGISTRY_MANAGED_IDENTITY_ID }}'
param gateway_containerimage = '{{ .Image }}'
param gateway_containerport = '{{ targetPortOrDefault 8080 }}'
param gateway_identity_outputs_clientid = '{{ .Env.GATEWAY_IDENTITY_CLIENTID }}'
param gateway_identity_outputs_id = '{{ .Env.GATEWAY_IDENTITY_ID }}'
param insights_outputs_appinsightsconnectionstring = '{{ .Env.INSIGHTS_APPINSIGHTSCONNECTIONSTRING }}'
param messaging_outputs_servicebusendpoint = '{{ .Env.MESSAGING_SERVICEBUSENDPOINT }}'
param messaging_outputs_servicebushostname = '{{ .Env.MESSAGING_SERVICEBUSHOSTNAME }}'
param parcelgo_webhook_secret_value = '{{ securedParameter "parcelgo_webhook_secret" }}'
param redis_password_value = '{{ securedParameter "redis_password" }}'
