{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [
          "http://localhost:5049",
          "https://localhost:7120"
        ],
        "ValidIssuer": "dotnet-user-jwts"
      }
    }
  },
  "RateLimits": {
    "PerMerchant": {
      "TokenLimit": 100,
      "TokensPerPeriod": 50,
      "PeriodSeconds": 1
    }
  }
}