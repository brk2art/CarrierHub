{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Azure": "Warning"
    }
  },
  "Aspire": {
    "Azure": {
      "Messaging": {
        "ServiceBus": {
          "ClientOptions": {
            "RetryOptions": {
              "Mode": "Exponential",
              "TryTimeout": "00:00:05",
              "MaxRetries": 3,
              "Delay": "00:00:00.200",
              "MaxDelay": "00:00:02"
            }
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
