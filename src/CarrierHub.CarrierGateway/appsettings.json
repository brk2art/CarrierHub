{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning",
      "Azure": "Warning"
    }
  },
  "Dedupe": {
    "Enabled": true
  },
  "Carriers": {
    "fastship": {
      "RequestsPerMinute": 120,
      "Resilience": {
        "AttemptTimeout": { "Timeout": "00:00:02" },
        "TotalRequestTimeout": { "Timeout": "00:00:08" },
        "Retry": {
          "MaxRetryAttempts": 3,
          "Delay": "00:00:00.200",
          "BackoffType": "Exponential",
          "UseJitter": true
        },
        "CircuitBreaker": {
          "FailureRatio": 0.5,
          "MinimumThroughput": 10,
          "SamplingDuration": "00:00:30",
          "BreakDuration": "00:00:15"
        }
      }
    },
    "nordpost": {
      "RequestsPerMinute": 30,
      "Resilience": {
        "AttemptTimeout": { "Timeout": "00:00:05" },
        "TotalRequestTimeout": { "Timeout": "00:00:15" },
        "Retry": {
          "MaxRetryAttempts": 2,
          "Delay": "00:00:01",
          "BackoffType": "Exponential",
          "UseJitter": true
        },
        "CircuitBreaker": {
          "FailureRatio": 0.5,
          "MinimumThroughput": 5,
          "SamplingDuration": "00:00:30",
          "BreakDuration": "00:00:30"
        }
      }
    }
  },
  "AllowedHosts": "*"
}