<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The assistant is an ASP.NET Core project; referencing it from a console app needs the ASP.NET framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CarrierHub.OpsAssistant\CarrierHub.OpsAssistant.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="golden.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>